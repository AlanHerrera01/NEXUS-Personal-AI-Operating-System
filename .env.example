# Backend-only configuration. Copy to backend/.env for local development.
APP_NAME=NEXUS API
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# -- sandboxed execution (Phase 10) -----------------------------------------
# Master switch. Off by default: with this false no sandbox-backed tool is wired.
# Turning it on does not authorize anything by itself, every call still requires
# a Trust Engine ALLOW.
RUNTIME_ENABLED=false
# OPENSHELL = real NVIDIA isolation. LOCAL = development workspace jail with no
# kernel-level isolation. IN_MEMORY = tests. There is no hidden fallback: if the
# selected runtime is unreachable the call fails rather than running on the host.
RUNTIME_PROVIDER=LOCAL
RUNTIME_WORKSPACE_ROOT=./.nexus-runtime
RUNTIME_MAX_EXECUTION_SECONDS=30
RUNTIME_MAX_OUTPUT_BYTES=262144
RUNTIME_MAX_MEMORY_MB=512
RUNTIME_MAX_CPU=1
RUNTIME_MAX_FILESYSTEM_BYTES=67108864
RUNTIME_MAX_NETWORK_REQUESTS=16
RUNTIME_MAX_TOOL_CALLS=10
RUNTIME_MAX_PROCESSES=64
RUNTIME_EXPIRATION_SECONDS=900
# Comma-separated paths the sandbox may read but never write.
RUNTIME_READ_ONLY_PATHS=/usr,/lib,/lib64,/bin,/sbin,/etc,/dev/urandom
# "host:port:access" triples, e.g. "api.example.com:443:read-only". Empty means
# no egress at all.
RUNTIME_ALLOWED_ENDPOINTS=
RUNTIME_ALLOWED_BINARIES=/usr/bin/ls,/usr/bin/cat,/usr/bin/wc,/usr/bin/sort
# Optional JSON object that replaces the command allowlist entirely,
# e.g. {"ls": ["-la"], "cat": []}. Empty means use the built-in defaults.
RUNTIME_ALLOWED_COMMANDS_JSON=
# Bounds the runtime *driver*, not the workload. Must exceed
# RUNTIME_MAX_EXECUTION_SECONDS; startup fails if it does not, because the driver
# has to outlive the workload it carries.
RUNTIME_COMMAND_TIMEOUT_SECONDS=120

# Credential custody. deny_all is the default and the only value to ship
# unattended: with it, no credential is resolvable at all.
#   deny_all             - nothing is resolvable
#   environment          - resolve NEXUS_CRED_* variables under an explicit grant
#   resolver_placeholder - hand the sandbox openshell:resolve:env:NAME instead
RUNTIME_CREDENTIAL_PROVIDER=deny_all
RUNTIME_CREDENTIAL_NAMES=

# -- always-on (Phase 12) ---------------------------------------------------
# Master switch. Off by default. The routes stay mounted either way so existing
# schedules can be inspected, paused and deleted, but anything that would START
# unattended work (create a job, ingest an event, create a rule) returns 503.
# Turning this on authorizes nothing by itself: every triggered run is still
# re-decided by the Trust Engine and can still stop for human approval.
ALWAYS_ON_ENABLED=false
# Shared secret for POST /api/v1/events/trigger, compared in constant time.
# LEAVE EMPTY UNLESS YOU MEAN TO EXPOSE WEBHOOK INGRESS: an unset secret closes
# the endpoint and rejects every request, so a missing secret fails shut rather
# than open. Minimum 32 characters when set.
ALWAYS_ON_EVENT_INGRESS_SECRET=
# How often due jobs are collected. Exactly-once dispatch does not depend on this:
# a unique constraint plus a compare-and-set claim does the work, so polling
# faster or slower cannot cause a duplicate or a missed slot.
ALWAYS_ON_POLL_INTERVAL_SECONDS=5
# How many due jobs one tick will consider.
ALWAYS_ON_MAX_JOBS_PER_TICK=50
# Hard ceiling on one execution. Exceeding it fails the run rather than leaving it
# RUNNING forever. Must exceed ALWAYS_ON_POLL_INTERVAL_SECONDS.
ALWAYS_ON_JOB_TIMEOUT_SECONDS=300
# A RUNNING execution older than this is failed on startup. Must exceed
# ALWAYS_ON_JOB_TIMEOUT_SECONDS, or recovery would fail runs still working.
# Recovery never retries: retrying an unattended side effect is how a transient
# error becomes a duplicated action.
ALWAYS_ON_STALE_EXECUTION_SECONDS=1800
# An occurrence older than this is recorded SKIPPED and rescheduled from now
# instead of replayed. Replaying a week of missed intervals would be a stampede.
ALWAYS_ON_GRACE_SECONDS=900
# Bounds how much work one user can have in flight at once. Exceeding it is
# recorded as SKIPPED, not FAILED, so a busy minute is visible without looking
# like a failure.
ALWAYS_ON_MAX_CONCURRENT_RUNS=3
# Refused at creation, not rate-limited later: a 1-second interval is a
# denial-of-service button that spends model calls and opens runs forever.
ALWAYS_ON_MIN_INTERVAL_SECONDS=300
ALWAYS_ON_MAX_ACTIVE_JOBS_PER_USER=20
# Retries for transient dispatch failures. Kept small on purpose: every retry is
# a real agent run.
ALWAYS_ON_MAX_RETRIES=2
# Webhook rate limiting.
ALWAYS_ON_MAX_EVENTS_PER_MINUTE=60
ALWAYS_ON_MAX_JOBS_PER_EVENT=20
ALWAYS_ON_MAX_PROACTIVE_RULES_PER_USER=50
