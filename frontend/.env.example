# NEXUS Frontend Environment Configuration
# Copy this file to .env and configure the values

# Base URL of the NEXUS backend. Every route lives under this origin
# (e.g. http://localhost:8000/api/v1/overview), so do NOT append /api/v1 here.
VITE_API_BASE_URL=http://localhost:8000

# Optional: application display name.
VITE_APP_NAME=NEXUS
