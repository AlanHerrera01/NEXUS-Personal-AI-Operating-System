# NEXUS Environment Configuration
# Copy this file to .env and configure the values

# PostgreSQL Configuration
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=nexus

# Backend Configuration
DATABASE_URL=postgresql+psycopg://nexus@localhost:5432/nexus
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=NEXUS API

# Nebius Configuration
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# The response budget covers the model's reasoning and its answer together. The
# model above reasons by default, so a budget sized for the answer alone can be
# spent before any content is emitted, and the run fails with an empty reply.
LLM_MAX_TOKENS=2048

# Agent Configuration
# Which decision maker the orchestrator wires. "llm" asks the model above, so the
# chat answers; "rule_based" is a deterministic local brain for a deployment with
# no model credentials, and it answers from templates rather than reasoning.
AGENT_BRAIN=llm

# Security Configuration
# AUTH_TOKEN_HASH is appended by scripts/setup_local.py. Never put the key in VITE_*.
TRUST_DEFAULT_DECISION=DENY
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Web tools (web.search / web.fetch)
# "auto" uses Brave when WEB_SEARCH_API_KEY is set and falls back to
# DuckDuckGo's HTML endpoint otherwise. DuckDuckGo is best-effort and can
# return an anti-bot challenge from a datacenter IP; Brave is the reliable path.
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=10
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_CHARS=1200
WEB_FETCH_ALLOWED_PORTS=80,443

# Files and documents
# The workspace is mounted read-only by Compose. Change this only if you also
# change the volume; the path is a jail, not a hint.
FILES_WORKSPACE_ROOT=/workspace
FILES_MAX_READ_BYTES=10485760
FILES_MAX_SEARCH_BYTES=1048576
FILES_MAX_SEARCH_FILES=5000
FILES_MAX_SEARCH_RESULTS=50
FILES_MAX_EXTRACT_BYTES=20971520

# Local knowledge base (chunked keyword retrieval; no external embeddings)
KNOWLEDGE_MAX_DOCUMENT_CHARS=200000
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=150

# Email (read and draft only; there is no send tool)
# Leave EMAIL_ENABLED=false until the IMAP values below are complete.
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_USE_SSL=true
EMAIL_DEFAULT_MAILBOX=INBOX
EMAIL_DRAFTS_MAILBOX=Drafts
EMAIL_FROM_ADDRESS=
EMAIL_TIMEOUT_SECONDS=15
EMAIL_MAX_MESSAGES=25
EMAIL_MAX_BODY_CHARS=20000

# Docker logs (read-only; exact names or glob patterns)
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_ALLOWED_CONTAINERS=nexus-*-backend-1,nexus-*-frontend-1,nexus-*-postgres-1
DOCKER_TIMEOUT_SECONDS=10
DOCKER_MAX_TAIL=2000
DOCKER_MAX_LOG_CHARS=50000

# Git diff (read-only repository mounted by Compose at /repo)
GIT_REPO_PATH=/repo
# Docker Desktop bind mounts are slower than native Linux; Compose overrides
# this to 120. Lower it on a native Linux host if desired.
GIT_TIMEOUT_SECONDS=15
GIT_MAX_DIFF_CHARS=50000

# MCP servers registered from the panel
# A registration stores configuration. The connection is opened later by the
# "test connection" action or by an agent run, and every tool call still goes
# through the Trust Engine. Keep these lower than the generic tool timeout.
MCP_CONNECT_TIMEOUT_SECONDS=8
MCP_TOOL_TIMEOUT_SECONDS=25
MCP_MAX_TOOLS_PER_SERVER=40
MCP_MAX_TOTAL_TOOLS=80
MCP_MAX_DESCRIPTION_CHARS=600
MCP_MAX_SCHEMA_CHARS=8000
MCP_MAX_OUTPUT_CHARS=20000
# Running a command supplied by the form is remote code execution. Leave these
# off. If a deployment truly needs a local stdio server, enable both settings
# and list the exact executable path.
MCP_ALLOW_STDIO=false
MCP_ALLOWED_STDIO_COMMANDS=
# Remote MCP endpoints are checked by the SSRF guard. Allow a local server
# explicitly (host or host:port) only when that endpoint is trusted.
MCP_ALLOWED_PRIVATE_HOSTS=
# GitHub MCP: put a fine-grained PAT here and reference it from the MCP form as
# Authorization=Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}. It is resolved at
# connect time and is never written to the mcp_servers table.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Public repository metadata/files and explicit user/org listings need no token.
# Private reads and writes require the token above. Public reads: 60 requests/hour/IP.
GITHUB_DEFAULT_REPOSITORY=
GITHUB_TIMEOUT_SECONDS=20

# Memory retrieval: keyword works offline; semantic uses real pgvector vectors.
# Switching to semantic sends saved memory and queries to your embedding provider.
MEMORY_SEARCH_MODE=keyword
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=20

# Always-On (disabled by default)
# The ingress secret is deliberately empty: an unset secret closes the webhook
# rather than shipping a guessable default.
ALWAYS_ON_ENABLED=false
ALWAYS_ON_EVENT_INGRESS_SECRET=
